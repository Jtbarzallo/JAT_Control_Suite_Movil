{
  "name": "JAT Revisión de Mercadería",
  "short_name": "JAT Revisión",
  "description": "Revisión de mercadería contra egresos, con kardex de códigos y productos",
  "start_url": "JAT_Revision_Mercaderia.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b2440",
  "theme_color": "#0b2440",
  "icons": [
    {
      "src": "icon-revision-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-revision-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "id": "JAT_Revision_Mercaderia.html",
  "share_target": {
    "action": "JAT_Revision_Mercaderia.html?compartido=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "archivo",
          "accept": [
            "application/pdf",
            ".pdf",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "application/vnd.ms-excel",
            ".xls",
            "text/csv",
            ".csv",
            "text/plain",
            ".txt"
          ]
        }
      ]
    }
  }
}