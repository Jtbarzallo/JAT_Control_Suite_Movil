{
  "name": "JAT Control Suite",
  "short_name": "JAT Suite",
  "description": "Verificación de egresos, kardex e inventario",
  "start_url": "JAT_Control_Suite_Venta.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#061b34",
  "theme_color": "#061b34",
  "icons": [
    {
      "src": "icon-venta-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-venta-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "id": "JAT_Control_Suite_Venta.html",
  "share_target": {
    "action": "JAT_Control_Suite_Venta.html?compartido=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "archivo",
          "accept": [
            "application/pdf",
            ".pdf",
            "application/json",
            ".json",
            ".hat",
            "application/octet-stream",
            "text/csv",
            ".csv"
          ]
        }
      ]
    }
  }
}